erDiagram
    USERS ||--o| JOB_SEEKERS : "has profile"
    USERS ||--o| EMPLOYERS : "has profile"
    USERS ||--o{ COMPANIES : "owns"
    USERS ||--o{ NOTIFICATIONS : "receives"

    COMPANIES ||--o{ JOB_POSTING : "posts"
    EMPLOYERS ||--o{ JOB_POSTING : "creates"

    JOB_SEEKERS ||--o{ RESUMES : "has"
    JOB_SEEKERS ||--o{ EDUCATIONS : "has"
    JOB_SEEKERS ||--o{ SKILLS : "has"
    JOB_SEEKERS ||--o{ APPLICATIONS : "submits"

    JOB_POSTING ||--o{ APPLICATIONS : "receives"
    RESUMES ||--o{ APPLICATIONS : "used in"

    APPLICATIONS ||--o{ INTERVIEWS : "schedules"
    APPLICATIONS ||--o{ NOTIFICATIONS : "triggers"

    USERS {
        uuid user_id PK
        varchar username UK
        varchar email UK
        varchar phone_number
        varchar role
        varchar profile_picture
        timestamptz date_registered
        varchar account_status
    }

    COMPANIES {
        bigint company_id PK
        uuid owner_id FK
        varchar company_name
        varchar company_address
        varchar industry
        text company_description
        varchar contact_email
        varchar contact_number
        varchar company_website
        varchar company_status
        timestamptz date_registered
    }

    EMPLOYERS {
        bigint employer_id PK
        uuid user_id FK
        bigint company_id FK
        varchar first_name
        varchar last_name
        varchar position
        varchar phone_number
        timestamptz date_joined
    }

    JOB_SEEKERS {
        bigint seeker_id PK
        uuid user_id FK
        varchar first_name
        varchar last_name
        varchar middle_name
        varchar gender
        varchar address
        varchar phone_number
        date date_of_birth
        varchar education
        text skills
        text experience
        text bio
    }

    RESUMES {
        bigint resume_id PK
        bigint seeker_id FK
        varchar resume_title
        text work_experience
        text certifications
        varchar resume_file
        timestamptz date_created
        boolean is_default
    }

    EDUCATIONS {
        bigint education_id PK
        bigint seeker_id FK
        varchar school_level
        varchar school_name
        varchar degree
        smallint year_started
        smallint year_ended
        timestamptz date_created
    }

    SKILLS {
        bigint skill_id PK
        bigint seeker_id FK
        varchar skill_name
        varchar skill_category
        varchar proficiency_level
    }

    JOB_POSTING {
        bigint job_id PK
        bigint company_id FK
        bigint employer_id FK
        varchar job_title
        text job_description
        text qualifications
        text skills_required
        varchar employment_type
        varchar salary_range
        varchar location
        timestamptz date_posted
        date application_deadline
        varchar job_status
    }

    APPLICATIONS {
        bigint application_id PK
        bigint seeker_id FK
        bigint job_id FK
        bigint resume_id FK
        timestamptz application_date
        varchar application_status
        text cover_letter
    }

    INTERVIEWS {
        bigint interview_id PK
        bigint application_id FK
        date interview_date
        time interview_time
        varchar interview_type
        varchar interview_location
        varchar interview_status
        text interview_notes
    }

    NOTIFICATIONS {
        bigint notification_id PK
        uuid user_id FK
        bigint application_id FK
        varchar notification_type
        text message
        timestamptz date_sent
        boolean is_read
        timestamptz date_read
    }
